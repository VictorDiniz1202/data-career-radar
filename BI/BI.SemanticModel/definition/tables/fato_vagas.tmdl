	column data_primeira_vez
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: 0697d417-22cc-4110-8653-272610d388f6
		summarizeBy: none
		sourceColumn: data_primeira_vez

		annotation UnderlyingDateTimeDataType = Date

	partition fato_vagas = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database("localhost:5433", "radar_db", [Query = "SELECT id, source, board_slug, external_id, title, location, is_remote, country_code, url, updated_at, first_seen_at, last_seen_at, is_data_role, match_score, salary_extracted, match_reason, match_model, evaluated_at FROM job_postings"]),
				    Tipos = Table.TransformColumnTypes(Fonte, {{"id", Int64.Type}, {"is_remote", type logical}, {"is_data_role", type logical}, {"country_code", type text}, {"match_score", Int64.Type}, {"updated_at", type datetime}, {"first_seen_at", type datetime}, {"last_seen_at", type datetime}, {"evaluated_at", type datetime}}),
				    EmpresaKey = Table.AddColumn(Tipos, "empresa_key", each [source] & "|" & [board_slug], type text),
				    DataPrimeiraVez = Table.AddColumn(EmpresaKey, "data_primeira_vez", each Date.From([first_seen_at]), type date)
				in
				    DataPrimeiraVez

